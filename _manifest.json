{
  "manifest_version": 2,
  "id": "github.touristh.helldivers2-patch-feed",
  "version": "0.2.3",
  "name": "Helldivers 2 更新推送（已停用）",
  "description": "已停止维护。本版本为最终停用与迁移公告；随机配装请迁移至 Helldivers2DemocracyChooses，综合情报功能推荐 maibot_plugin_Helldivers。",
  "author": {
    "name": "TouristH",
    "url": "https://github.com/TouristH"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TouristH/HelldiversPatchFeed",
    "homepage": "https://github.com/TouristH/HelldiversPatchFeed",
    "documentation": "https://github.com/TouristH/HelldiversPatchFeed/blob/main/README.md",
    "issues": "https://github.com/TouristH/HelldiversPatchFeed/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.54.0"
    }
  ],
  "plugin_type": "integration",
  "capabilities": ["chat.open_session", "send.text", "send.image", "render.html2png"],
  "display": {
    "icon": {
      "type": "lucide",
      "value": "satellite"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
