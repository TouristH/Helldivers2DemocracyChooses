{
  "manifest_version": 2,
  "id": "github.touristh.helldivers2-democracy-chooses",
  "version": "0.4.1",
  "name": "绝地潜兵 2：民主帮你选择",
  "description": "HELLDIVERS 2（绝地潜兵2）配装插件，支持随机配装、按群启用的实验配装、八格离线图卡、单格重抽、Excel/CSV 配备标签知识库与渲染诊断；兼容 MaiBot 1.4 多实例与命令权限。",
  "author": {
    "name": "TouristH",
    "url": "https://github.com/TouristH"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TouristH/Helldivers2DemocracyChooses",
    "homepage": "https://github.com/TouristH/Helldivers2DemocracyChooses",
    "documentation": "https://github.com/TouristH/Helldivers2DemocracyChooses/blob/main/README.md",
    "issues": "https://github.com/TouristH/Helldivers2DemocracyChooses/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.22.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.54.0"
    }
  ],
  "plugin_type": "game",
  "capabilities": ["send.text", "send.image", "render.html2png"],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.webp",
      "fallback": "gamepad-2"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
